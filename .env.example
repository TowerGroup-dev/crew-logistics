CREW_SESSION_SECRET=replace-this-before-hosting
CREW_PASSWORD=your-office-password

# For npm run data:pull / data:push (copy data between local and live).
CREW_LIVE_URL=https://your-app.azurewebsites.net
CREW_LIVE_PASSWORD=your-office-password

# Power BI live API (Get data → Web). Treat like a password; pass as ?key= or Bearer.
# Example: https://your-app/api/powerbi/daily.csv?year=2026&key=...
CREW_POWERBI_KEY=
